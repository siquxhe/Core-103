# L3-a 最小加法程序（叠加路线 · loader 直接就位，不经引擎先搬）
# 程序段 0000..0002；数据段 3000..3002。地址/数值均为八进制。
#   0000  +00 3000 3001  ; mem[3001] = mem[3000] + mem[3001] = 3 + 4 = 7
#   0001  +05 3001 3002  ; mem[3002] = mem[3001] = 7
#   0002  +54 0000 0000  ; 停机
0000@ +00 3000 3001
0001@ +05 3001 3002
0002@ +54 0000 0000
3000@ 3
3001@ 4
3002@ 0
